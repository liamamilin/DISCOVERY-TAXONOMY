{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery Taxonomy Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "arena",
    "lenses",
    "tags",
    "title",
    "old_assumption",
    "new_shift",
    "seed_prompts",
    "signals",
    "added_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(build|business|content|cognition|career|life)-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "arena": {
      "type": "string",
      "enum": [
        "build",
        "business",
        "content",
        "cognition",
        "career",
        "life"
      ]
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cost-collapse",
          "role-inversion",
          "invisible-friction",
          "first-principles",
          "cross-domain"
        ]
      }
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "title": {
      "$ref": "#/$defs/bilingualText"
    },
    "old_assumption": {
      "$ref": "#/$defs/bilingualText"
    },
    "new_shift": {
      "$ref": "#/$defs/bilingualText"
    },
    "seed_prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "en": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "note": {
            "$ref": "#/$defs/bilingualText"
          }
        }
      }
    },
    "added_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "$defs": {
    "bilingualText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 2
        },
        "en": {
          "type": "string",
          "minLength": 2
        }
      }
    }
  }
}
